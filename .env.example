# Copy to .env. Defaults match docker-compose.yml.

# Postgres — the workspace database (GoTrue uses its own `gotrue` database on the same server)
DATABASE_URL=postgres://postgres:quarry@localhost:5432/quarry

# Redis — BullMQ only
REDIS_URL=redis://localhost:6379

# GoTrue — the API verifies its JWTs locally with this secret
GOTRUE_URL=http://localhost:9999
GOTRUE_JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef

# Object storage (MinIO locally, any S3-compatible store in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=quarry
S3_SECRET_KEY=quarry-secret
S3_BUCKET=datasets

# The first verified login with this email becomes the workspace admin (only while there is none)
QUARRY_BOOTSTRAP_ADMIN_EMAIL=

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Source credentials: a source's `secret_ref` names an env var read by the sync worker only.
# Example for a source whose secret_ref is SOURCE_SAP_PG_PASSWORD:
# SOURCE_SAP_PG_PASSWORD=...

{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The tests also reach Catalog's DuckDB, to write real Parquet where a job's runtime would; the service never does.
        "paths": {
            "@quarry/forge-server/*":     ["./src/*"],
            "@quarry/catalog-server/*":   ["../../catalog/server/src/*"],
            "@quarry/platform-kernel/*":  ["../../../platform/kernel/*"],
            "@quarry/shared/*":           ["../../../libraries/shared/*"],
            "@quarry/integrations/*":     ["../../../libraries/integrations/*"]
        }
    },
    "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}

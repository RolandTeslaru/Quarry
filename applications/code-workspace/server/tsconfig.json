{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@quarry/code-workspace-server/*": [
                "./src/*"
            ],
            "@quarry/platform-kernel/*": [
                "../../../platform/kernel/*"
            ],
            "@quarry/shared/*": [
                "../../../libraries/shared/*"
            ],
            "@quarry/integrations/*": [
                "../../../libraries/integrations/*"
            ]
        },
        "rootDir": "../../..",
        "outDir": "./dist",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
        }
    },
    "include": [
        "src/**/*"
    ]
}

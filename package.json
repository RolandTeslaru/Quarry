{
    "name": "quarry",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n server,dc,system -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:data-connection\" \"npm:dev:system\"",
        "dev:server": "npm run dev:api --workspace=packages/server",
        "dev:data-connection": "npm run dev --workspace=packages/data-connection-worker",
        "dev:system": "npm run dev --workspace=packages/system-worker",
        "migrate": "npm run migrate --workspace=packages/server",
        "typecheck": "tsc -b packages/shared && npm run typecheck --workspace=packages/integrations --workspace=packages/server --workspace=packages/data-connection-worker --workspace=packages/system-worker",
        "build": "npm run build --workspace=packages/server --workspace=packages/data-connection-worker --workspace=packages/system-worker",
        "infra": "docker compose up -d postgres redis gotrue minio minio-init"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "concurrently": "^9.2.1",
        "typescript": "^5.9.3"
    }
}

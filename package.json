{
    "name": "quarry",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev:all": "npm run infra && npm run dev",
        "dev": "concurrently -n server,catalog,system,web -c cyan,magenta,yellow,green \"npm:dev:server\" \"npm:dev:catalog\" \"npm:dev:system\" \"npm:dev:frontend\"",
        "dev:server": "npm run dev:api --workspace=packages/server",
        "dev:catalog": "npm run dev --workspace=packages/catalog-service",
        "dev:data-connection": "npm run dev --workspace=packages/data-connection-worker",
        "dev:system": "npm run dev --workspace=packages/system-worker",
        "dev:code-workspace": "npm run dev --workspace=packages/code-workspace-worker",
        "dev:forge-agent": "npm run dev --workspace=packages/forge-agent",
        "migrate": "npm run migrate --workspace=packages/server",
        "test": "npm run test --workspace=packages/shared --workspace=packages/catalog-service --workspace=packages/server --workspace=packages/code-workspace-runtime",
        "typecheck": "tsc -b packages/shared && npm run typecheck --workspace=packages/integrations --workspace=packages/platform-server --workspace=packages/catalog-service --workspace=packages/server --workspace=packages/data-connection-worker --workspace=packages/system-worker --workspace=packages/code-workspace-worker --workspace=packages/forge-agent --workspace=packages/code-workspace-runtime --workspace=packages/code-workspace-extension --workspace=packages/standard-ui --workspace=packages/frontend",
        "build": "npm run build --workspace=packages/catalog-service --workspace=packages/server --workspace=packages/data-connection-worker --workspace=packages/system-worker --workspace=packages/code-workspace-worker --workspace=packages/forge-agent --workspace=packages/frontend",
        "build:code-workspace-ide": "npm run build --workspace=packages/code-workspace-runtime && npm run package --workspace=packages/code-workspace-extension && docker build -f docker/code-workspace-ide/Dockerfile -t quarry/code-workspace-ide:dev .",
        "build:code-workspace-runtime": "npm run build --workspace=packages/code-workspace-runtime && docker build -f docker/code-workspace-runtime/Dockerfile -t quarry/code-workspace-runtime:dev .",
        "infra": "docker compose up -d postgres redis gotrue seaweedfs seaweedfs-init",
        "dev:frontend": "npm run dev --workspace=packages/frontend"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "concurrently": "^9.2.1",
        "typescript": "^5.9.3"
    }
}

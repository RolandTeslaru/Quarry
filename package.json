{
    "name": "quarry",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "platform/*",
        "applications/*/*",
        "libraries/*"
    ],
    "scripts": {
        "dev:all": "npm run infra && npm run dev",
        "dev": "concurrently -n server,catalog,dc,dc-worker,system,web -c cyan,magenta,blue,red,yellow,green \"npm:dev:server\" \"npm:dev:catalog\" \"npm:dev:data-connection-service\" \"npm:dev:data-connection\" \"npm:dev:system\" \"npm:dev:frontend\"",
        "dev:server": "npm run dev:api --workspace=platform/server",
        "dev:catalog": "npm run dev --workspace=applications/catalog/server",
        "dev:data-connection": "npm run dev --workspace=applications/data-connection/worker",
        "dev:system": "npm run dev --workspace=platform/system-worker",
        "dev:code-workspace": "npm run dev --workspace=applications/code-workspace/worker",
        "dev:forge-agent": "npm run dev --workspace=applications/forge/agent",
        "migrate": "npm run migrate --workspace=platform/server",
        "test": "npm run test --workspace=libraries/shared --workspace=applications/catalog/server --workspace=applications/data-connection/server --workspace=platform/server --workspace=applications/code-workspace/runtime",
        "typecheck": "tsc -b libraries/shared && npm run typecheck --workspace=libraries/integrations --workspace=platform/kernel --workspace=applications/catalog/server --workspace=applications/data-connection/server --workspace=platform/server --workspace=applications/data-connection/worker --workspace=platform/system-worker --workspace=applications/code-workspace/worker --workspace=applications/forge/agent --workspace=applications/code-workspace/runtime --workspace=applications/code-workspace/vscode-extension --workspace=libraries/standard-ui --workspace=platform/frontend",
        "build": "npm run build --workspace=applications/catalog/server --workspace=applications/data-connection/server --workspace=platform/server --workspace=applications/data-connection/worker --workspace=platform/system-worker --workspace=applications/code-workspace/worker --workspace=applications/forge/agent --workspace=platform/frontend",
        "build:code-workspace-ide": "npm run build --workspace=applications/code-workspace/runtime && npm run package --workspace=applications/code-workspace/vscode-extension && docker build -f docker/code-workspace-ide/Dockerfile -t quarry/code-workspace-ide:dev .",
        "build:code-workspace-runtime": "npm run build --workspace=applications/code-workspace/runtime && docker build -f docker/code-workspace-runtime/Dockerfile -t quarry/code-workspace-runtime:dev .",
        "infra": "docker compose up -d postgres redis nats gotrue seaweedfs seaweedfs-init",
        "dev:frontend": "npm run dev --workspace=platform/frontend",
        "dev:data-connection-service": "npm run dev --workspace=applications/data-connection/server"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "concurrently": "^9.2.1",
        "typescript": "^5.9.3"
    }
}

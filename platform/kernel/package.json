{
    "name": "@quarry/platform-kernel",
    "version": "0.0.1",
    "private": true,
    "description": "The shared kernel every Quarry server imports (docs/design/architecture-split.md §4): auth, the database layer, queues and storage, and the Identity, Library, Gatekeeper and Audit modules. Imported as @quarry/platform-kernel/<path>; never imports a product.",
    "scripts": {
        "typecheck": "tsc --noEmit"
    },

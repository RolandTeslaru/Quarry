        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/lib-storage": "^3.1150.0",
        "@aws-sdk/s3-request-presigner": "^3.1150.0",
        "@nestjs/common": "^11.1.16",
        "@nestjs/core": "^11.1.16",
        "@nestjs/microservices": "11.2.7",
        "@nestjs/platform-express": "^11.1.16",
        "@quarry/shared": "*",
        "bullmq": "^5.67.2",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "ioredis": "^5.9.2",
        "jose": "^6.2.9",
        "kysely": "^0.28.9",
        "nats": "2.29.3",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/pg": "^8.15.6"
    }

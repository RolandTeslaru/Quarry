{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@quarry/platform-kernel/*": [
                "../kernel/*"
            ],
            "@quarry/catalog-server/*": [
                "../../applications/catalog/server/src/*"
            ],
            "@quarry/shared/*": [
                "../../libraries/shared/*"
            ],
            "@quarry/integrations/*": [
                "../../libraries/integrations/*"
            ],
            "@quarry/data-connection-server/*": [
                "../../applications/data-connection/server/src/*"
            ],
            "@quarry/forge-server/*": [
                "../../applications/forge/server/src/*"
            ]
        },
        "rootDir": "../..",
        "outDir": "./dist",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
        }
    },
    "include": [
        "src/**/*"
    ]
}

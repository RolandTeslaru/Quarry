# The IDE image needs only its own files, the transforms library, the bundled runtime and the packaged Quarry extension.
*
!docker/code-workspace-ide/
!applications/code-workspace/transforms-python/
!applications/code-workspace/vscode-extension/dist/quarry-code-workspace.vsix
!applications/code-workspace/runtime/dist/runtime.js
applications/code-workspace/transforms-python/.venv/
applications/code-workspace/transforms-python/**/__pycache__/
applications/code-workspace/transforms-python/.pytest_cache/

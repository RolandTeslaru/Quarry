{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@quarry/shared/*": ["../shared/*"]
        },
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "dist"]
}

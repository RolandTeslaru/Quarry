{
    "name": "quarry-code-workspace",
    "displayName": "Quarry",
    "description": "Quarry in the Code Workspaces IDE: Quarry's colour themes, what transforms' dataset references point to, and opening them in Quarry.",
    "publisher": "quarry",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "vscode": "^1.109.0"
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:python"
    ],
    "contributes": {
        "commands": [
            {
                "command": "quarry.openInQuarry",
                "title": "Open in Quarry",
                "category": "Quarry"
            },
            {
                "command": "quarry.useRid",
                "title": "Use the RID instead of the path",
                "category": "Quarry"
            },
            {
                "command": "quarry.preview",
                "title": "▶ Preview",
                "category": "Quarry"
            },
            {
                "command": "quarry.build",
                "title": "Build",
                "category": "Quarry"
            }
        ],
        "themes": [
            {
                "label": "Quarry Light",
                "uiTheme": "vs",
                "path": "./themes/quarry-light.json"
            },
            {
                "label": "Quarry Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/quarry-dark.json"
            }
        ],
        "viewsContainers": {
            "panel": [
                {
                    "id": "quarry",
                    "title": "Quarry",
                    "icon": "media/quarry.svg"
                },
                {
                    "id": "quarry-ui-kit",
                    "title": "UI Kit",
                    "icon": "media/quarry.svg"
                }
            ]
        },
        "views": {
            "quarry": [
                {
                    "type": "webview",
                    "id": "quarry.preview",
                    "name": "Preview"
                }
            ],
            "quarry-ui-kit": [
                {
                    "type": "webview",
                    "id": "quarry.components",
                    "name": "UI Kit"
                }
            ]
        },
        "menus": {
            "editor/title": [
                {
                    "command": "quarry.preview",
                    "group": "navigation@1",
                    "when": "resourceLangId == python"
                },
                {
                    "command": "quarry.build",
                    "group": "navigation@2",
                    "when": "resourceLangId == python"
                }
            ]
        }
    },
    "scripts": {
        "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
        "build:webviews": "node scripts/build-webviews.mjs && tailwindcss -i webviews/styles.css -o dist/webview/styles.css --minify",
        "build": "npm run build:extension && npm run build:webviews",
        "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out dist/quarry-code-workspace.vsix",
        "typecheck": "tsc --noEmit && tsc --noEmit -p webviews"
    },
    "dependencies": {
        "@quarry/shared": "*",
        "axios": "^1.13.4",
        "zod": "^4.3.6",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "@quarry/standard-ui": "*"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/vscode": "1.109.0",
        "@vscode/vsce": "4.0.0",
        "esbuild": "0.28.2",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@tailwindcss/cli": "4.3.3"
    }
}

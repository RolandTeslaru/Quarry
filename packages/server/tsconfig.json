{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@quarry/platform-server/*": [
                "../platform-server/*"
            ],
            "@quarry/catalog-service/*": [
                "../catalog-service/src/*"
            ],
            "@quarry/shared/*": [
                "../shared/*"
            ],
            "@quarry/integrations/*": [
                "../integrations/*"
            ]
        },
        "rootDir": "..",
        "outDir": "./dist",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
        }
    },
    "include": [
        "src/**/*"
    ]
}

{
    "name": "@quarry/server",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev:api": "nodemon -w src -w ../shared -w ../integrations -w migrations -e ts,json,sql --exec ts-node -r tsconfig-paths/register src/api.ts",
        "migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -R migrations dist/server/migrations",
        "start:api": "node dist/server/src/api.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@nestjs/common": "^11.1.16",
        "@nestjs/core": "^11.1.16",
        "@nestjs/platform-express": "^11.1.16",
        "@quarry/integrations": "*",
        "@quarry/shared": "*",
        "bullmq": "^5.67.2",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "ioredis": "^5.9.2",
        "jose": "^6.2.9",
        "kysely": "^0.28.9",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/pg": "^8.15.6",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.2",
        "tsconfig-paths": "^4.2.0"
    }
}
